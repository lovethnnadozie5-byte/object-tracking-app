{
  "expo": {
    "name": "Object Tracking App",
    "slug": "object-tracking-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.objecttracking.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to track objects in real-time",
        "NSLocationWhenInUseUsageDescription": "We need your location data to enhance tracking accuracy",
        "UIRequiredDeviceCapabilities": [
          "camera"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.objecttracking.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "targetSdkVersion": 33
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
